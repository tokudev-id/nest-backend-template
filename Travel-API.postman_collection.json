                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Comment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated comment content\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/articles/1/comments/1",
              "host": ["{{base_url}}"],
              "path": ["articles", "1", "comments", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/articles/1/comments/1",
              "host": ["{{base_url}}"],
              "path": ["articles", "1", "comments", "1"]
            }
          },
          "response": []
        }
      ]
    },
